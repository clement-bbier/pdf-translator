# Copy this file to .env and fill in the values before using provider: gateway.
# .env is gitignored and must never be committed. No secret belongs in
# config.yaml. Every value below is supplied by the team that manages the
# internal LLM gateway — ask them for the ones you do not have.
#
# With provider: mock (the default in config.yaml) none of this is needed.

# Base URL of the gateway's OpenAI-compatible API, without a trailing slash.
# "/chat/completions" is appended by the application.
# Format: https://<gateway-host>/<api-path>
# Ask the team that manages the internal gateway.
GATEWAY_BASE_URL=

# OAuth2 device authorization endpoint (RFC 8628): where the application asks
# for a device_code and the user_code shown at sign-in.
# Format: https://<auth-host>/<path>/devicecode
# Ask the team that manages the internal gateway.
GATEWAY_DEVICE_ENDPOINT=

# OAuth2 token endpoint: polled during sign-in, then used for token refresh.
# Format: https://<auth-host>/<path>/token
# Ask the team that manages the internal gateway.
GATEWAY_TOKEN_ENDPOINT=

# OAuth2 client_id registered for this application with the gateway.
# Format: an opaque string or a UUID, depending on the identity provider.
# Ask the team that manages the internal gateway.
GATEWAY_CLIENT_ID=

# OAuth2 scopes requested at sign-in, space-separated.
# Format: e.g. "openid profile <api-scope>" — the exact scope names come from
# the gateway team and decide what the issued token is allowed to call.
# Ask the team that manages the internal gateway.
GATEWAY_SCOPES=
